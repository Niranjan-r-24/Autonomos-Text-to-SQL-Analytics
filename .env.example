# -------------------------------------------------------------
# Autonomos Text-to-SQL Analytics - Environment Configuration
# -------------------------------------------------------------

# AI Provider Keys (Optional: Leave blank to use built-in schema engine)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_PROVIDER=gemini

# Database Connection
# SQLite (Local development default):
DATABASE_URL=sqlite:///autonomos.db
# PostgreSQL (Production on Render/AWS/Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server Configuration
PORT=8000
MAX_QUERY_LIMIT=1000
DEFAULT_QUERY_LIMIT=100
