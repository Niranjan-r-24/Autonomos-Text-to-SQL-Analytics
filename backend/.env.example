# -------------------------------------------------------------
# Backend Environment Variables (Render / Cloud Deployment)
# -------------------------------------------------------------

# AI Provider Keys (Optional: Leave blank to use built-in schema engine)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_PROVIDER=gemini

# Database Connection (SQLite default, or PostgreSQL connection string)
DATABASE_URL=sqlite:///autonomos.db

# Server
PORT=8000
MAX_QUERY_LIMIT=1000
DEFAULT_QUERY_LIMIT=100
