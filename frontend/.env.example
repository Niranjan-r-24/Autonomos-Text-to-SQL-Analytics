# Deployed Backend API URL (NO trailing slash)
# Leave blank for local development proxy (defaults to http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com
BACKEND_URL=https://your-backend-service.onrender.com
