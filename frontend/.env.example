# Frontend Environment Variables (.env.local / Vercel Environment Variables)

# Replace with your deployed Render backend URL (NO trailing slash)
# Example: https://autonomos-text2sql-api.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# Optional: Next.js backend proxy target for server rewrites
BACKEND_URL=https://your-backend-service.onrender.com
